{
  "$defs": {
    "AnalysisError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "failed_phase": {
          "title": "Failed Phase",
          "type": "string"
        },
        "at_sec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At Sec"
        }
      },
      "required": [
        "code",
        "message",
        "failed_phase"
      ],
      "title": "AnalysisError",
      "type": "object"
    },
    "CheckProgress": {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "enum": [
            "queued",
            "decode",
            "perception",
            "facts",
            "rules",
            "evidence",
            "done",
            "failed",
            "cancelled"
          ],
          "title": "Phase",
          "type": "string"
        },
        "phases": {
          "items": {
            "enum": [
              "decode",
              "perception",
              "facts",
              "rules",
              "evidence"
            ],
            "type": "string"
          },
          "title": "Phases",
          "type": "array"
        },
        "processed_until_sec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Processed Until Sec"
        },
        "queue_position": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queue Position"
        }
      },
      "required": [
        "phase"
      ],
      "title": "CheckProgress",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "start_sec": {
          "minimum": 0,
          "title": "Start Sec",
          "type": "number"
        },
        "end_sec": {
          "minimum": 0,
          "title": "End Sec",
          "type": "number"
        },
        "scope": {
          "enum": [
            "cashier",
            "client",
            "desk",
            "storage",
            "whole"
          ],
          "title": "Scope",
          "type": "string"
        },
        "reason": {
          "enum": [
            "out_of_frame",
            "occluded",
            "low_light",
            "motion_blur"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "start_sec",
        "end_sec",
        "scope",
        "reason"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "enum": [
                "confirmed",
                "rejected",
                "not_visible"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "note": {
          "default": "",
          "maxLength": 2000,
          "title": "Note",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        }
      },
      "required": [
        "value",
        "decided_at"
      ],
      "title": "Decision",
      "type": "object"
    },
    "EvidenceFrame": {
      "additionalProperties": false,
      "properties": {
        "frame_id": {
          "pattern": "^fr-[0-9]+$",
          "title": "Frame Id",
          "type": "string"
        },
        "timestamp_sec": {
          "minimum": 0,
          "title": "Timestamp Sec",
          "type": "number"
        },
        "overlay_boxes": {
          "items": {
            "$ref": "#/$defs/OverlayBox"
          },
          "title": "Overlay Boxes",
          "type": "array"
        }
      },
      "required": [
        "frame_id",
        "timestamp_sec"
      ],
      "title": "EvidenceFrame",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "pattern": "^fd-[0-9a-f]{10}$",
          "title": "Finding Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "type_label": {
          "title": "Type Label",
          "type": "string"
        },
        "timecode_sec": {
          "minimum": 0,
          "title": "Timecode Sec",
          "type": "number"
        },
        "window": {
          "$ref": "#/$defs/TimeWindow"
        },
        "basis": {
          "items": {
            "pattern": "^ob-[0-9]+$",
            "type": "string"
          },
          "title": "Basis",
          "type": "array"
        },
        "what_seen": {
          "title": "What Seen",
          "type": "string"
        },
        "why_may_violate": {
          "title": "Why May Violate",
          "type": "string"
        },
        "norm_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Norm Refs",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceFrame"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "strength": {
          "enum": [
            "strong",
            "moderate"
          ],
          "title": "Strength",
          "type": "string"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "finding_id",
        "rule_id",
        "type_label",
        "timecode_sec",
        "window",
        "basis",
        "what_seen",
        "why_may_violate",
        "norm_refs",
        "description",
        "evidence",
        "strength"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingSet": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "basis": {
          "enum": [
            "auto",
            "reviewer"
          ],
          "title": "Basis",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "layout_revision": {
          "minimum": 1,
          "title": "Layout Revision",
          "type": "integer"
        },
        "role_overrides": {
          "items": {
            "$ref": "#/$defs/RoleOverride"
          },
          "title": "Role Overrides",
          "type": "array"
        },
        "verdict": {
          "enum": [
            "violation",
            "no_violation"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/RuleStatus"
          },
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "revision",
        "basis",
        "created_at",
        "layout_revision",
        "verdict"
      ],
      "title": "FindingSet",
      "type": "object"
    },
    "NotCheckableWindow": {
      "additionalProperties": false,
      "properties": {
        "start_sec": {
          "minimum": 0,
          "title": "Start Sec",
          "type": "number"
        },
        "end_sec": {
          "minimum": 0,
          "title": "End Sec",
          "type": "number"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "start_sec",
        "end_sec",
        "reason"
      ],
      "title": "NotCheckableWindow",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "start_sec": {
          "minimum": 0,
          "title": "Start Sec",
          "type": "number"
        },
        "end_sec": {
          "minimum": 0,
          "title": "End Sec",
          "type": "number"
        },
        "obs_id": {
          "pattern": "^ob-[0-9]+$",
          "title": "Obs Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "person_in_zone",
            "cash_in_hands",
            "cash_on_desk",
            "cash_handover",
            "counting_motion",
            "phone_visible",
            "bag_present",
            "bag_opened",
            "storage_open",
            "visibility_low",
            "cash_sorting",
            "cash_packing",
            "bag_integrity_damage",
            "personal_item_identified",
            "camera_device_visible"
          ],
          "title": "Kind",
          "type": "string"
        },
        "subjects": {
          "items": {
            "pattern": "^[po][0-9]+$",
            "type": "string"
          },
          "title": "Subjects",
          "type": "array"
        },
        "zones": {
          "items": {
            "type": "string"
          },
          "title": "Zones",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "frame_ids": {
          "items": {
            "pattern": "^fr-[0-9]+$",
            "type": "string"
          },
          "title": "Frame Ids",
          "type": "array"
        },
        "provenance": {
          "anyOf": [
            {
              "enum": [
                "detector",
                "temporal_model",
                "geometry",
                "reviewer"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "actor_id": {
          "anyOf": [
            {
              "pattern": "^[po][0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Id"
        },
        "recipient_id": {
          "anyOf": [
            {
              "pattern": "^[po][0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipient Id"
        }
      },
      "required": [
        "start_sec",
        "end_sec",
        "obs_id",
        "kind"
      ],
      "title": "Observation",
      "type": "object"
    },
    "OverlayBox": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tone": {
          "enum": [
            "observation",
            "finding"
          ],
          "title": "Tone",
          "type": "string"
        }
      },
      "required": [
        "bbox",
        "label",
        "tone"
      ],
      "title": "OverlayBox",
      "type": "object"
    },
    "RoleOverride": {
      "additionalProperties": false,
      "properties": {
        "track_id": {
          "pattern": "^[po][0-9]+$",
          "title": "Track Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "cashier",
            "client",
            "collector",
            "controller",
            "staff",
            "outsider",
            "unknown"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "track_id",
        "role"
      ],
      "title": "RoleOverride",
      "type": "object"
    },
    "RuleStatus": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "violation",
            "no_violation",
            "not_checkable",
            "partly_checkable"
          ],
          "title": "Status",
          "type": "string"
        },
        "not_checkable_windows": {
          "items": {
            "$ref": "#/$defs/NotCheckableWindow"
          },
          "title": "Not Checkable Windows",
          "type": "array"
        }
      },
      "required": [
        "rule_id",
        "status"
      ],
      "title": "RuleStatus",
      "type": "object"
    },
    "SceneLayout": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "zones": {
          "items": {
            "$ref": "#/$defs/Zone"
          },
          "title": "Zones",
          "type": "array"
        },
        "camera_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Note"
        }
      },
      "required": [
        "revision"
      ],
      "title": "SceneLayout",
      "type": "object"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "properties": {
        "start_sec": {
          "minimum": 0,
          "title": "Start Sec",
          "type": "number"
        },
        "end_sec": {
          "minimum": 0,
          "title": "End Sec",
          "type": "number"
        }
      },
      "required": [
        "start_sec",
        "end_sec"
      ],
      "title": "TimeWindow",
      "type": "object"
    },
    "Track": {
      "additionalProperties": false,
      "properties": {
        "track_id": {
          "pattern": "^[po][0-9]+$",
          "title": "Track Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "person",
            "object"
          ],
          "title": "Kind",
          "type": "string"
        },
        "object_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Class"
        },
        "first_sec": {
          "minimum": 0,
          "title": "First Sec",
          "type": "number"
        },
        "last_sec": {
          "minimum": 0,
          "title": "Last Sec",
          "type": "number"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrackRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/TrackSample"
          },
          "title": "Samples",
          "type": "array"
        }
      },
      "required": [
        "track_id",
        "kind",
        "first_sec",
        "last_sec"
      ],
      "title": "Track",
      "type": "object"
    },
    "TrackRole": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "enum": [
            "cashier",
            "client",
            "collector",
            "controller",
            "staff",
            "outsider",
            "unknown"
          ],
          "title": "Value",
          "type": "string"
        },
        "source": {
          "default": "auto",
          "enum": [
            "auto",
            "reviewer"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "TrackRole",
      "type": "object"
    },
    "TrackSample": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "t",
        "bbox",
        "score"
      ],
      "title": "TrackSample",
      "type": "object"
    },
    "VideoMeta": {
      "additionalProperties": false,
      "properties": {
        "duration_sec": {
          "minimum": 0,
          "title": "Duration Sec",
          "type": "number"
        },
        "fps_nominal": {
          "exclusiveMinimum": 0,
          "title": "Fps Nominal",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "rotation": {
          "default": 0,
          "enum": [
            0,
            90,
            180,
            270
          ],
          "title": "Rotation",
          "type": "integer"
        }
      },
      "required": [
        "duration_sec",
        "fps_nominal",
        "width",
        "height"
      ],
      "title": "VideoMeta",
      "type": "object"
    },
    "Zone": {
      "additionalProperties": false,
      "properties": {
        "zone_id": {
          "pattern": "^z-[a-z_]+-[0-9]+$",
          "title": "Zone Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "cashier_post",
            "client_window",
            "cash_desk",
            "storage",
            "service_door",
            "transfer_tray",
            "count_room"
          ],
          "title": "Kind",
          "type": "string"
        },
        "polygon": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 32,
          "minItems": 3,
          "title": "Polygon",
          "type": "array"
        },
        "source": {
          "default": "auto",
          "enum": [
            "auto",
            "reviewer"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "zone_id",
        "kind",
        "polygon"
      ],
      "title": "Zone",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "file_name": {
      "title": "File Name",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "processing",
        "done",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "duration_sec": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Sec"
    },
    "verdict": {
      "anyOf": [
        {
          "enum": [
            "violation",
            "no_violation"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verdict"
    },
    "findings_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Findings Count"
    },
    "is_example": {
      "default": false,
      "title": "Is Example",
      "type": "boolean"
    },
    "analysis_origin": {
      "default": "local",
      "enum": [
        "local",
        "cache"
      ],
      "title": "Analysis Origin",
      "type": "string"
    },
    "analyzed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Analyzed At"
    },
    "automatic_verdict": {
      "anyOf": [
        {
          "enum": [
            "violation",
            "no_violation"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Automatic Verdict"
    },
    "video": {
      "anyOf": [
        {
          "$ref": "#/$defs/VideoMeta"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "progress": {
      "$ref": "#/$defs/CheckProgress"
    },
    "layout": {
      "anyOf": [
        {
          "$ref": "#/$defs/SceneLayout"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tracks": {
      "items": {
        "$ref": "#/$defs/Track"
      },
      "title": "Tracks",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Observations",
      "type": "array"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/Coverage"
      },
      "title": "Coverage",
