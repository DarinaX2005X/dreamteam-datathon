{
  "$defs": {
    "RoleOverride": {
      "additionalProperties": false,
      "properties": {
        "track_id": {
          "pattern": "^[po][0-9]+$",
          "title": "Track Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "cashier",
            "client",
            "collector",
            "controller",
            "staff",
            "outsider",
            "unknown"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "track_id",
        "role"
      ],
      "title": "RoleOverride",
      "type": "object"
    },
    "Zone": {
      "additionalProperties": false,
      "properties": {
        "zone_id": {
          "pattern": "^z-[a-z_]+-[0-9]+$",
          "title": "Zone Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "cashier_post",
            "client_window",
            "cash_desk",
            "storage",
            "service_door",
            "transfer_tray",
            "count_room"
          ],
          "title": "Kind",
          "type": "string"
        },
        "polygon": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 32,
          "minItems": 3,
          "title": "Polygon",
          "type": "array"
        },
        "source": {
          "default": "auto",
          "enum": [
            "auto",
            "reviewer"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "zone_id",
        "kind",
        "polygon"
      ],
      "title": "Zone",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_revision": {
      "minimum": 1,
      "title": "Base Revision",
      "type": "integer"
    },
    "role_overrides": {
      "items": {
        "$ref": "#/$defs/RoleOverride"
      },
      "title": "Role Overrides",
      "type": "array"
    },
    "zone_overrides": {
      "items": {
        "$ref": "#/$defs/Zone"
      },
      "title": "Zone Overrides",
      "type": "array"
    },
    "dry_run": {
      "default": false,
      "title": "Dry Run",
      "type": "boolean"
    }
  },
  "required": [
    "base_revision"
  ],
  "title": "ReevaluateRequest",
  "type": "object"
}
