# Copy to .env. Never commit the generated key or provider/tunnel credentials.
NAVIDU_ENV=production
NAVIDU_API_KEYS=replace-with-a-long-random-key
NAVIDU_HOST=0.0.0.0
NAVIDU_PORT=8000

# Container paths; local launch scripts default these to project-owned directories.
NAVIDU_DATA_DIR=/app/data
NAVIDU_MODELS_DIR=/app/models
NAVIDU_RULES_DIR=/app/rules
NAVIDU_WEB_DIST=/app/web/dist
NAVIDU_DATASET_DIR=

NAVIDU_DEVICE=cuda
NAVIDU_WORKERS=1
NAVIDU_MAX_UPLOAD_MB=300
NAVIDU_MAX_DURATION_SEC=600
NAVIDU_UI_MAX_ACTIVE_PER_IP=2
NAVIDU_QUEUE_MAX=20
NAVIDU_RETAIN_VIDEO_HOURS=24
NAVIDU_RETAIN_RESULTS_DAYS=7
NAVIDU_EVIDENCE_OVERLAY=true
NAVIDU_EXAMPLE_CHECK_ID=
NAVIDU_ANALYSIS_FPS=3
NAVIDU_PIPELINE_VERSION=0.1.0
NAVIDU_FFPROBE=ffprobe

# Production requires both configured models. Set false only for the documented
# detector-only diagnostic profile; temporal and semantic rules will be unavailable.
NAVIDU_DETECTOR_MODEL=rfdetr-nano-onnx
NAVIDU_SEMANTIC_MODEL=internvl3_5-1b
NAVIDU_REQUIRE_SEMANTIC=true
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
